From 0ec6514327fa3a3ea175b903719e71bbf55846b8 Mon Sep 17 00:00:00 2001
Message-Id: <deinterlace-without-yadif@streamary.invalid>
From: Streamary <noreply@streamary.invalid>
Date: Sat, 3 Oct 2026 15:37:53 +0200
Subject: [PATCH] deinterlace: build without the yadif modes

yadif.h and yadif_template.h come from FFmpeg under the GPL; the rest of the plugin is LGPL. The default mode ("auto" -> "x") and every other mode stay; asking for yadif falls back to blend.

(libvlcjni checks this line: Message-Id: <deinterlace-without-yadif@streamary.invalid>)
---
 modules/video_filter/Makefile.am               | 2 --
 modules/video_filter/deinterlace/deinterlace.c | 4 ----
 modules/video_filter/deinterlace/deinterlace.h | 5 ++---
 3 files changed, 2 insertions(+), 9 deletions(-)

diff --git a/modules/video_filter/Makefile.am b/modules/video_filter/Makefile.am
index f65344d..c1d8d08 100644
--- a/modules/video_filter/Makefile.am
+++ b/modules/video_filter/Makefile.am
@@ -131,8 +131,6 @@ libdeinterlace_plugin_la_SOURCES = \
 	video_filter/deinterlace/helpers.c video_filter/deinterlace/helpers.h \
 	video_filter/deinterlace/algo_basic.c video_filter/deinterlace/algo_basic.h \
 	video_filter/deinterlace/algo_x.c video_filter/deinterlace/algo_x.h \
-	video_filter/deinterlace/algo_yadif.c video_filter/deinterlace/algo_yadif.h \
-	video_filter/deinterlace/yadif.h video_filter/deinterlace/yadif_template.h \
 	video_filter/deinterlace/algo_phosphor.c video_filter/deinterlace/algo_phosphor.h \
 	video_filter/deinterlace/algo_ivtc.c video_filter/deinterlace/algo_ivtc.h
 # inline ASM doesn't build with -O0
diff --git a/modules/video_filter/deinterlace/deinterlace.c b/modules/video_filter/deinterlace/deinterlace.c
index 9f9d529..073424d 100644
--- a/modules/video_filter/deinterlace/deinterlace.c
+++ b/modules/video_filter/deinterlace/deinterlace.c
@@ -362,10 +362,6 @@ static struct filter_mode_t filter_mode [] = {
                  { false, false, false, true }, true, true },
     { "blend", .pf_render_single_pic = RenderBlend,
                  { false, false, false, false }, true, true },
-    { "yadif", .pf_render_single_pic = RenderYadifSingle,
-                 { false, true, false, false }, false, true },
-    { "yadif2x", .pf_render_ordered = RenderYadif,
-                 { true, true, false, false }, false, true },
     { "x", .pf_render_single_pic = RenderX,
                  { false, false, false, false }, false, false },
     { "phosphor", .pf_render_ordered = RenderPhosphor,
diff --git a/modules/video_filter/deinterlace/deinterlace.h b/modules/video_filter/deinterlace/deinterlace.h
index 355f2f4..e79629b 100644
--- a/modules/video_filter/deinterlace/deinterlace.h
+++ b/modules/video_filter/deinterlace/deinterlace.h
@@ -39,7 +39,6 @@ struct vlc_object_t;
 /* Local algorithm headers */
 #include "algo_basic.h"
 #include "algo_x.h"
-#include "algo_yadif.h"
 #include "algo_phosphor.h"
 #include "algo_ivtc.h"
 #include "common.h"
@@ -51,12 +50,12 @@ struct vlc_object_t;
 /** Available deinterlace modes. */
 static const char *const mode_list[] = {
     "discard", "blend", "mean", "bob", "linear", "x",
-    "yadif", "yadif2x", "phosphor", "ivtc" };
+    "phosphor", "ivtc" };
 
 /** User labels for the available deinterlace modes. */
 static const char *const mode_list_text[] = {
     N_("Discard"), N_("Blend"), N_("Mean"), N_("Bob"), N_("Linear"), "X",
-    "Yadif", "Yadif (2x)", N_("Phosphor"), N_("Film NTSC (IVTC)") };
+    N_("Phosphor"), N_("Film NTSC (IVTC)") };
 
 /*****************************************************************************
  * Data structures
