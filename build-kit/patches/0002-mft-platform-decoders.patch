@@ -624,30 +633,55 @@ error:
 }
 
 /* Copy a packed buffer (no padding) to a picture_t */
-static void CopyPackedBufferToPicture(picture_t *p_pic, const uint8_t *p_src)
+/* Copies a decoded frame laid out the way Media Foundation documents it: each plane is src_pitch (scaled like the
+ * picture's planes) by src_lines (the output type's frame height, which the decoders pad, e.g. 1088 for 1080p) and the
+ * planes follow each other. The picture only takes the visible part. Reading the planes at the visible height instead
+ * put the chroma of 1080-line H.264 rows below its luma. */
+static void CopyPackedBufferToPicture(picture_t *p_pic, const uint8_t *p_src, size_t src_length,
+                                      unsigned src_pitch, unsigned src_lines)
 {
+    const uint8_t *p_end = p_src + src_length;
+    const plane_t *p_luma = &p_pic->p[0];
+    if (src_pitch < (unsigned)p_luma->i_visible_pitch)
+        src_pitch = p_luma->i_visible_pitch;
+    if (src_lines < (unsigned)p_luma->i_visible_lines)
+        src_lines = p_luma->i_visible_lines;
+
     for (int i = 0; i < p_pic->i_planes; ++i)
     {
-        uint8_t *p_dst = p_pic->p[i].p_pixels;
-
-        if (p_pic->p[i].i_visible_pitch == p_pic->p[i].i_pitch)
+        const plane_t *p_plane = &p_pic->p[i];
+        /* NV12/P010 chroma has the luma pitch; I420 chroma half of it. */
+        const size_t plane_pitch = (size_t)src_pitch * p_plane->i_visible_pitch / p_luma->i_visible_pitch;
+        const size_t plane_lines = ((size_t)src_lines * p_plane->i_visible_lines + p_luma->i_visible_lines - 1) / p_luma->i_visible_lines;
+        uint8_t *p_dst = p_plane->p_pixels;
+        for (int i_line = 0; i_line < p_plane->i_visible_lines; i_line++)
         {
-            /* Plane is packed, only one memcpy is needed. */
-            uint32_t plane_size = p_pic->p[i].i_pitch * p_pic->p[i].i_visible_lines;
-            memcpy(p_dst, p_src, plane_size);
-            p_src += plane_size;
-            continue;
-        }
-
-        for (int i_line = 0; i_line < p_pic->p[i].i_visible_lines; i_line++)
-        {
-            memcpy(p_dst, p_src, p_pic->p[i].i_visible_pitch);
-            p_src += p_pic->p[i].i_visible_pitch;
-            p_dst += p_pic->p[i].i_pitch;
+            const uint8_t *p_line = p_src + (size_t)i_line * plane_pitch;
+            if (p_line + p_plane->i_visible_pitch > p_end)
+                return;
+            memcpy(p_dst, p_line, p_plane->i_visible_pitch);
+            p_dst += p_plane->i_pitch;
         }
+        p_src += plane_pitch * plane_lines;
     }
 }
 
+/* The source layout of the decoder's output (see CopyPackedBufferToPicture); zero when the type doesn't say. */
+static void GetOutputLayout(decoder_t *p_dec, unsigned *pitch, unsigned *lines)
+{
+    decoder_sys_t *p_sys = p_dec->p_sys;
+    *pitch = 0;
+    *lines = 0;
+    if (!p_sys->output_type)
+        return;
+    UINT32 stride = 0;
+    if (SUCCEEDED(IMFMediaType_GetUINT32(p_sys->output_type, &MF_MT_DEFAULT_STRIDE, &stride)))
+        *pitch = (INT32)stride < 0 ? (unsigned)-(INT32)stride : stride;
+    UINT64 frame_size = 0;
+    if (SUCCEEDED(IMFMediaType_GetUINT64(p_sys->output_type, &MF_MT_FRAME_SIZE, &frame_size)))
+        *lines = (UINT32)frame_size;
+}
+
 static int ProcessOutputStream(decoder_t *p_dec, DWORD stream_id)
 {
     decoder_sys_t *p_sys = p_dec->p_sys;
@@ -657,8 +691,7 @@ static int ProcessOutputStream(decoder_t *p_dec, DWORD stream_id)
 
     DWORD output_status = 0;
     MFT_OUTPUT_DATA_BUFFER output_buffer = { stream_id, p_sys->output_sample, 0, NULL };
-    hr = IMFTransform_ProcessOutput(p_sys->mft, 0, 1, &output_buffer, &output_status);
-    if (output_buffer.pEvents)
+    hr = IMFTransform_ProcessOutput(p_sys->mft, 0, 1, &output_buffer, &output_status);    if (output_buffer.pEvents)
         IMFCollection_Release(output_buffer.pEvents);
     /* Use the returned sample since it can be provided by the MFT. */
