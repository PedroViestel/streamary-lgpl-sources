         if (FAILED(hr))
             goto error;
 
         if (p_dec->fmt_in.i_cat == VIDEO_ES)
-            CopyPackedBufferToPicture(picture, buffer_start);
+        {
+            unsigned src_pitch, src_lines;
+            GetOutputLayout(p_dec, &src_pitch, &src_lines);
+            if (!p_sys->layout_logged)
+            {
+                msg_Dbg(p_dec, "output buffer %lu bytes, pitch %u, %u lines (picture %dx%d visible)", (unsigned long)buffer_length,
+                        src_pitch, src_lines, picture->p[0].i_visible_pitch, picture->p[0].i_visible_lines);
+                p_sys->layout_logged = true;
+            }
+            CopyPackedBufferToPicture(picture, buffer_start, buffer_length, src_pitch, src_lines);
+        }
         else
             memcpy(aout_buffer->p_buffer, buffer_start, total_length);
 
@@ -754,6 +798,7 @@ static int ProcessOutputStream(decoder_t *p_dec, DWORD stream_id)
         p_sys->output_sample = NULL;
         if (AllocateOutputSample(p_dec, 0, &p_sys->output_sample))
             goto error;
+        p_sys->got_output = true; /* ask again with the new type */
         return VLC_SUCCESS;
     }
     else if (hr == MF_E_TRANSFORM_NEED_MORE_INPUT)
@@ -771,6 +816,7 @@ static int ProcessOutputStream(decoder_t *p_dec, DWORD stream_id)
         decoder_QueueVideo(p_dec, picture);
     else
         decoder_QueueAudio(p_dec, aout_buffer);
+    p_sys->got_output = true;
 
     return VLC_SUCCESS;
 
@@ -796,13 +842,18 @@ static int DecodeSync(decoder_t *p_dec, block_t *p_block)
         return VLCDEC_SUCCESS;
     }
 
-    /* Drain the output stream before sending the input packet. */
-    if (ProcessOutputStream(p_dec, p_sys->output_stream_id))
-        goto error;
     if (ProcessInputStream(p_dec, p_sys->input_stream_id, p_block))
         goto error;
     block_Release(p_block);
 
+    /* Take every output the MFT has ready, not only one per input. */
+    do
+    {
+        p_sys->got_output = false;
+        if (ProcessOutputStream(p_dec, p_sys->output_stream_id))
+            return VLCDEC_SUCCESS;
+    } while (p_sys->got_output);
+
     return VLCDEC_SUCCESS;
 
 error:
@@ -902,6 +953,73 @@ error:
 
 static void DestroyMFT(decoder_t *p_dec);
 
+/* HEVC from MP4/MKV: the hvcC record's parameter sets (VPS/SPS/PPS) as Annex B, and the NAL length size used by
+ * the packets. NULL when it isn't an hvcC record (an Annex B stream, e.g. from MPEG-TS, has no conversion). */
+static uint8_t *hvcC_to_AnnexB(const uint8_t *p, size_t n, size_t *out_size, uint8_t *nal_length_size)
+{
+    if (n < 23 || p[0] != 1)
+        return NULL;
+
+    size_t total = 0;
+    for (int pass = 0; pass < 2; ++pass)
+    {
+        uint8_t *out = NULL;
+        if (pass == 1)
+        {
+            out = malloc(total);
+            if (!out)
+                return NULL;
+        }
+        size_t pos = 23, written = 0;
+        for (unsigned a = 0; a < p[22]; ++a)
+        {
+            if (pos + 3 > n)
+                goto bad;
+            unsigned count = (p[pos + 1] << 8) | p[pos + 2];
+            pos += 3;
+            for (unsigned i = 0; i < count; ++i)
+            {
+                if (pos + 2 > n)
+                    goto bad;
+                size_t len = (p[pos] << 8) | p[pos + 1];
+                pos += 2;
+                if (pos + len > n)
+                    goto bad;
+                if (out)
+                {
+                    static const uint8_t start_code[4] = { 0, 0, 0, 1 };
+                    memcpy(out + written, start_code, 4);
+                    memcpy(out + written + 4, p + pos, len);
+                }
+                written += 4 + len;
+                pos += len;
+            }
+        }
+        if (pass == 0)
+        {
+            if (written == 0)
+                return NULL;
+            total = written;
+            continue;
+        }
+        *out_size = written;
+        *nal_length_size = (p[21] & 3) + 1;
+        return out;
+bad:
+        free(out);
+        return NULL;
+    }
+    return NULL;
+}
+
+/* Seek: drop what the MFT holds; H.264 SPS/PPS go in again with the next packet. */
+static void Flush(decoder_t *p_dec)
+{
+    decoder_sys_t *p_sys = p_dec->p_sys;
+    IMFTransform_ProcessMessage(p_sys->mft, MFT_MESSAGE_COMMAND_FLUSH, 0);
+    p_sys->sent_extra = false;
+}
+
 static int InitializeMFT(decoder_t *p_dec)
 {
     decoder_sys_t *p_sys = p_dec->p_sys;
@@ -979,11 +1097,28 @@ static int InitializeMFT(decoder_t *p_dec)
     if (FAILED(hr))
         goto error;
 
-    if (p_dec->fmt_in.i_codec == VLC_CODEC_H264)
-    {
-        /* It's not an error if the following call fails. */
+    /* Low-latency mode for H.264 and HEVC. Without it the decoders hold up to ~38 frames before the first output;
+     * VLC's start wait gives up ("buffer deadlock prevented"), the clock starts on the audio and every picture
+     * then arrives late and is dropped. With it they are slower (Microsoft's H.264 decoder: 1080p 7x, 4K 2x real
+     * time instead of 25x and 8x), which is still enough up to 4K at 30 fps. It's not an error if the call fails. */
+    if (attributes && (p_dec->fmt_in.i_codec == VLC_CODEC_H264 || p_dec->fmt_in.i_codec == VLC_CODEC_HEVC))
         IMFAttributes_SetUINT32(attributes, &CODECAPI_AVLowLatencyMode, true);
 
+    if (p_dec->fmt_in.i_codec == VLC_CODEC_HEVC && p_dec->fmt_in.i_extra)
+    {
+        size_t i_buf;
+        uint8_t *buf = hvcC_to_AnnexB(p_dec->fmt_in.p_extra, p_dec->fmt_in.i_extra,
+                                      &i_buf, &p_sys->nal_length_size);
+        if (buf)
+        {
+            free(p_dec->fmt_in.p_extra);
+            p_dec->fmt_in.p_extra = buf;
+            p_dec->fmt_in.i_extra = i_buf;
+        }
+    }
+
+    if (p_dec->fmt_in.i_codec == VLC_CODEC_H264)
+    {
         if (p_dec->fmt_in.i_extra)
         {
             if (h264_isavcC((uint8_t*)p_dec->fmt_in.p_extra, p_dec->fmt_in.i_extra))
@@ -1115,11 +1250,41 @@ static int LoadMFTLibrary(MFHandle *mf)
     return VLC_SUCCESS;
 }
 
+static int DecodeWaitingForSize(decoder_t *p_dec, block_t *p_block)
+{
+    VLC_UNUSED(p_dec);
+    if (p_block)
+        block_Release(p_block);
+    return VLCDEC_SUCCESS;
+}
+
 static int Open(vlc_object_t *p_this)
 {
     decoder_t *p_dec = (decoder_t *)p_this;
     decoder_sys_t *p_sys;
 
+    /* Formats this module doesn't take go to the next decoder without an error message. */
+    if (!FormatToGUID(p_dec->fmt_in.i_cat == VIDEO_ES ? video_format_table : audio_format_table,
+                      p_dec->fmt_in.i_codec))
+        return VLC_EGENERIC;
+
+    /* Windows' HEVC decoder (HEVC Video Extensions) crashes in MFT_MESSAGE_NOTIFY_BEGIN_STREAMING when the input
+     * type has no frame size. */
+    /* So it opens unconfigured and drops the stream until the packetizer finds the size, which restarts this decoder
+     * ("input format change"): a live TS has no size at first, and no software HEVC decoder ships to open it. */
+    if (p_dec->fmt_in.i_codec == VLC_CODEC_HEVC
+     && (!p_dec->fmt_in.video.i_width || !p_dec->fmt_in.video.i_height))
+    {
+        msg_Dbg(p_dec, "HEVC size not known yet; waiting for it");
+        p_sys = p_dec->p_sys = calloc(1, sizeof(*p_sys));
+        if (!p_sys)
+            return VLC_ENOMEM;
+        p_sys->waiting_for_size = true;
+        p_dec->pf_decode = DecodeWaitingForSize;
+        p_dec->pf_flush = NULL;
+        return VLC_SUCCESS;
+    }
+
     p_sys = p_dec->p_sys = calloc(1, sizeof(*p_sys));
     if (!p_sys)
         return VLC_ENOMEM;
@@ -1138,7 +1303,8 @@ static int Open(vlc_object_t *p_this)
 
     if (FindMFT(p_dec))
     {
-        msg_Err(p_dec, "Could not find suitable MFT decoder");
+        /* e.g. HEVC without Microsoft's HEVC Video Extensions, or a Windows N edition without Media Foundation */
+        msg_Warn(p_dec, "Could not find suitable MFT decoder");
         goto error;
     }
 
@@ -1147,6 +1313,7 @@ static int Open(vlc_object_t *p_this)
         goto error;
 
     p_dec->pf_decode = p_sys->is_async ? DecodeAsync : DecodeSync;
+    p_dec->pf_flush = Flush;
 
     return VLC_SUCCESS;
 
@@ -1161,6 +1328,12 @@ static void Close(vlc_object_t *p_this)
     decoder_sys_t *p_sys = p_dec->p_sys;
     MFHandle *mf = &p_sys->mf_handle;
 
+    if (p_sys->waiting_for_size)
+    {
+        free(p_sys);
+        return;
+    }
+
     DestroyMFT(p_dec);
 
     if (mf->mfplat_dll)
