From 4705f3a579257d4a923e4bb140fb75fe406e246e Mon Sep 17 00:00:00 2001
Message-Id: <subtitles-mojibake@streamary.invalid>
From: Streamary <noreply@streamary.invalid>
Date: Sun, 1 Nov 2026 14:00:00 +0000
Subject: [PATCH] subtitles: repair text encoded to UTF-8 twice
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Many subtitle files (fansubs, rips) were read as Windows-1252 by the tool that made them and written back as UTF-8:
"é" became "Ã©", "à" "Ã" plus a no-break space, "í" "Ã" plus an invisible soft hyphen. The text is valid UTF-8, so
subsdec (SRT and other plain text) and libass (ASS/SSA, which takes UTF-8 as it comes) showed it as it is.

modules/codec/mojibake.h turns such a text back when every character of it fits in one Windows-1252 byte (Latin-1 for
the five positions 1252 leaves out) and those bytes are themselves valid UTF-8 with at least one multi-byte sequence.
Correct Latin text fails that test (c-cedilla then a-tilde gives E7 E3, not UTF-8), and so does any text with a
character outside Windows-1252 (CJK, music notes left intact), so those lines stay as they are. subsdec repairs after
its charset conversion; libass repairs each event before ass_process_chunk.

(libvlcjni checks this line: Message-Id: <subtitles-mojibake@streamary.invalid>)
---
 modules/codec/libass.c   |   5 ++
 modules/codec/mojibake.h | 142 +++++++++++++++++++++++++++++++++++++++
 modules/codec/subsdec.c  |  10 +++
 3 files changed, 157 insertions(+)
 create mode 100644 modules/codec/mojibake.h

diff --git a/modules/codec/libass.c b/modules/codec/libass.c
index b8f0de4..3ee725a 100644
--- a/modules/codec/libass.c
+++ b/modules/codec/libass.c
@@ -43,6 +43,8 @@
 
 #include <ass/ass.h>
 
+#include "mojibake.h"
+
 #if LIBASS_VERSION < 0x01300000
 # define ASS_FONTPROVIDER_AUTODETECT 1
 #endif
@@ -399,6 +401,9 @@ static int DecodeBlock( decoder_t *p_dec, block_t *p_block )
     }
     memcpy( p_spu_sys->p_subs_data, p_block->p_buffer,
             p_block->i_buffer );
+    /* Text encoded to UTF-8 twice by the tool that made the file */
+    p_spu_sys->i_subs_len = vlc_mojibake_repair( p_spu_sys->p_subs_data,
+                                                 p_block->i_buffer );
 
     p_spu->i_start = p_block->i_pts;
     p_spu->i_stop = __MAX( p_sys->i_max_stop, p_block->i_pts + p_block->i_length );
diff --git a/modules/codec/mojibake.h b/modules/codec/mojibake.h
new file mode 100644
index 0000000..edd8406
--- /dev/null
+++ b/modules/codec/mojibake.h
@@ -0,0 +1,142 @@
+/*****************************************************************************
+ * mojibake.h: repairs subtitle text that was encoded to UTF-8 twice
+ *****************************************************************************
